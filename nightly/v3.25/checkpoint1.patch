+    def _prepare_render_image(self,image: QImage,render_tile:int):
+        """Finish resize/crop in the decoder thread so GUI paint stays cheap."""
+        if image is None or image.isNull():return QImage()
+        if self.proportional_mode:
+            limit=QSize(int(render_tile*3.2),int(render_tile*3.2))
+            return image.scaled(limit,Qt.AspectRatioMode.KeepAspectRatio,Qt.TransformationMode.SmoothTransformation)
+        if self.fit_mode:
+            return image.scaled(QSize(render_tile,render_tile),Qt.AspectRatioMode.KeepAspectRatio,Qt.TransformationMode.SmoothTransformation)
+        scaled=image.scaled(QSize(render_tile,render_tile),Qt.AspectRatioMode.KeepAspectRatioByExpanding,Qt.TransformationMode.SmoothTransformation)
+        if scaled.isNull():return scaled
+        sx=max(0,(scaled.width()-render_tile)//2);sy=max(0,(scaled.height()-render_tile)//2)
+        return scaled.copy(sx,sy,min(render_tile,scaled.width()),min(render_tile,scaled.height()))
